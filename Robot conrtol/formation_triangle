import time
import math
from pose_camera import start_camera, stop_camera, get_pose
from robot_driver import Robot

# ================= НАСТРОЙКИ ФОРМАЦИИ =================

# Желаемые смещения роботов относительно центра формации (в пикселях камеры)
# Равносторонний треугольник, сторона ~200 пикселей
FORMATION_OFFSETS = {
    "ROBOT_001": {"dx": 0, "dy": -100},    # Лидер (спереди по центру)
    "ROBOT_002": {"dx": -87, "dy": 50},    # Левый задний
    "ROBOT_003": {"dx": 87, "dy": 50},     # Правый задний
}

TARGET_SPEED_VX = 0.3   # Скорость движения формации вперёд (доли от 1, медленно!)
KP_POS = 0.5            # Коэффициент коррекции позиции (P-регулятор)
KP_YAW = 1.0            # Коэффициент удержания курса
MAX_OMEGA = 0.5         # Максимальная угловая скорость
MAX_V = 0.6             # Максимальная линейная скорость

# ======================================================


def normalize_angle(angle):
    """Нормализует угол в диапазон [-pi, pi]."""
    return (angle + math.pi) % (2 * math.pi) - math.pi


def calculate_target_pose(robot_id, centroid_x, centroid_y, centroid_yaw):
    """
    Рассчитывает целевую позицию (x, y, yaw) для конкретного робота
    на основе центра формации и его смещения.
    """
    offset = FORMATION_OFFSETS.get(robot_id, {"dx": 0, "dy": 0})

    # Поворот смещения на угол ориентации формации (2D-ротация)
    cos_a = math.cos(centroid_yaw)
    sin_a = math.sin(centroid_yaw)

    target_x = centroid_x + (offset["dx"] * cos_a - offset["dy"] * sin_a)
    target_y = centroid_y + (offset["dx"] * sin_a + offset["dy"] * cos_a)
    target_yaw = centroid_yaw  # Все роботы смотрят в одну сторону

    return target_x, target_y, target_yaw


def get_all_poses():
    """
    ЗАГЛУШКА: должна возвращать {robot_id: (x, y, yaw, timestamp)} для ВСЕХ видимых роботов.
    Сейчас твоя pose_camera.py возвращает данные только по одному TARGET_ID.
    Это нужно доработать — см. комментарий ниже.
    """
    pose = get_pose()
    if pose is None:
        return {}
    
    # ВРЕМЕННО: возвращаем одного робота с захардкоженным ID
    # В реальности здесь должен быть цикл по всем детектированным тегам
    x, y, yaw, ts = pose
    return {"ROBOT_001": (x, y, yaw, ts)}


def main():
    print("🚀 Запуск системы управления формацией «Треугольник»...")
    start_camera()

    # Словарь подключенных роботов (ключ — robot_id)
    robots = {}
    # TODO: инициализация через robot_config_store.load_robot_config() + Robot.connect()
    # Пока оставим пустым — нужно решить, как подключать нескольких роботов одновременно

    try:
        while True:
            # 1. Получаем данные со всех роботов
            poses = get_all_poses()

            if len(poses) < 3:
                print(f"⚠️  Видно только {len(poses)} робота(ов), нужно 3. Ждём...")
                for r in robots.values():
                    r.drive(0, 0, 0)
                time.sleep(0.1)
                continue

            # 2. Вычисляем центр формации (среднее арифметическое по всем роботам)
            xs = [p[0] for p in poses.values()]
            ys = [p[1] for p in poses.values()]
            centroid_x = sum(xs) / len(xs)
            centroid_y = sum(ys) / len(ys)

            # Угол формации — берём от лидера (ROBOT_001) или усредняем
            leader_id = "ROBOT_001"
            centroid_yaw = poses[leader_id][2] if leader_id in poses else 0.0

            # 3. Для каждого робота считаем ошибку и команду
            for robot_id, (curr_x, curr_y, curr_yaw, ts) in poses.items():
                if robot_id not in robots:
                    continue  # Пропускаем, если робот не инициализирован

                target_x, target_y, target_yaw = calculate_target_pose(
                    robot_id, centroid_x, centroid_y, centroid_yaw
                )

                # Ошибки
                err_x = target_x - curr_x
                err_y = target_y - curr_y
                err_yaw = normalize_angle(target_yaw - curr_yaw)

                # Простейшее управление: движение к своей точке + общее движение вперёд
                cmd_vx = TARGET_SPEED_VX + KP_POS * err_x
                cmd_vy = KP_POS * err_y
                cmd_w = KP_YAW * err_yaw

                # Ограничения (клиппинг)
                cmd_vx = max(-MAX_V, min(MAX_V, cmd_vx))
                cmd_vy = max(-MAX_V, min(MAX_V, cmd_vy))
                cmd_w = max(-MAX_OMEGA, min(MAX_OMEGA, cmd_w))

                # 4. Отправка команды конкретному роботу
                robots[robot_id].drive(cmd_vx, cmd_vy, cmd_w)

                # 5. Логирование (опционально)
                # log_writer.writerow([time.time(), robot_id, curr_x, curr_y, curr_yaw, cmd_vx, cmd_vy, cmd_w])

            time.sleep(0.05)  # 20 Гц

    except KeyboardInterrupt:
        print("\n🛑 Остановка по команде пользователя")
    finally:
        for r in robots.values():
            r.stop()
        stop_camera()


if __name__ == "__main__":
    main()
