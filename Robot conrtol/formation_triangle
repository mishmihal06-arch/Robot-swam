"""
formation_triangle.py — управление формацией «Треугольник» для 3 роботов.
Реализовано:
- Задача 8: Математика равностороннего треугольника
- Задача 10: Конечный автомат (BUILDING → READY → MOVING)
- Задача 11: Аварийная остановка (клавиша S)
- Задача 7: Логирование в CSV
"""

import time
import math
import csv
import cv2
from pose_camera import start_camera, stop_camera, get_all_poses, get_frame
from robot_driver import Robot, load_config
from robot_config_store import find_robots, load_robot_config

# ================= НАСТРОЙКИ =================

TAG_IDS = [10, 11, 12]
LEADER_TAG_ID = 10

# Параметры равностороннего треугольника (Задача 8)
SIDE_LENGTH = 200  # пикселей — длина стороны треугольника

# Параметры управления
TARGET_SPEED_VX = 0.3
KP_POS = 0.5
KP_YAW = 1.0
MAX_OMEGA = 0.5
MAX_V = 0.6

# Критерий "треугольник построен"
BUILD_TOLERANCE = 15
BUILD_STABLE_TIME = 1.0

CONNECTION_TIMEOUT = 2.0

# ======================================================


def normalize_angle(angle):
    return (angle + math.pi) % (2 * math.pi) - math.pi


# ================= ЗАДАЧА 8: Математика треугольника =================

def calculate_equilateral_triangle(poses, side_length=SIDE_LENGTH):
    """
    Рассчитывает 3 точки равностороннего треугольника вокруг центроида.
    """
    xs = [poses[tid][1] for tid in poses]
    ys = [poses[tid][2] for tid in poses]
    centroid_x = sum(xs) / len(xs)
    centroid_y = sum(ys) / len(ys)
    
    h = side_length * math.sqrt(3) / 2
    
    targets = {
        10: {"x": centroid_x, "y": centroid_y - h * 2/3},
        11: {"x": centroid_x - side_length / 2, "y": centroid_y + h * 1/3},
        12: {"x": centroid_x + side_length / 2, "y": centroid_y + h * 1/3}
    }
    
    return targets


def assign_robots_to_targets(poses, targets):
    """Назначает каждого робота ближайшей целевой точке."""
    assignments = {}
    used_targets = set()
    
    for tag_id in poses:
        curr_x, curr_y = poses[tag_id][1], poses[tag_id][2]
        
        best_target = None
        best_dist = float('inf')
        
        for target_id, target_pos in targets.items():
            if target_id in used_targets:
                continue
            
            dist = math.hypot(target_pos["x"] - curr_x, target_pos["y"] - curr_y)
            
            if dist < best_dist:
                best_dist = dist
                best_target = target_id
        
        if best_target is not None:
            assignments[tag_id] = targets[best_target]
            used_targets.add(best_target)
    
    return assignments


def compute_control_cmd(curr_x, curr_y, curr_yaw, target_x, target_y, moving=False):
    """Считает команду (vf, vl, w) для робота."""
    err_x = target_x - curr_x
    err_y = target_y - curr_y
    err_yaw = -curr_yaw  # Держим курс "вверх"

    cmd_vx = KP_POS * err_x
    cmd_vy = KP_POS * err_y
    cmd_w = KP_YAW * err_yaw

    if moving:
        cmd_vx += TARGET_SPEED_VX * math.cos(curr_yaw)
        cmd_vy += TARGET_SPEED_VX * math.sin(curr_yaw)

    cmd_vx = max(-MAX_V, min(MAX_V, cmd_vx))
    cmd_vy = max(-MAX_V, min(MAX_V, cmd_vy))
    cmd_w = max(-MAX_OMEGA, min(MAX_OMEGA, cmd_w))

    return cmd_vx, cmd_vy, cmd_w


def connect_all_robots():
    """Сканирует сеть и подключается ко всем роботам."""
    print("🔍 Сканирование сети...")
    found = find_robots(seconds=5.0)
    
    if not found:
        raise RuntimeError("Роботы не найдены в сети!")
    
    print(f"✅ Найдено роботов: {len(found)}")
    
    robots = {}
    for tag_id in TAG_IDS:
        robot_id = f"ROBOT_{tag_id}"
        if robot_id not in found:
            print(f"⚠️  Робот {robot_id} не найден!")
            continue
        
        ip, port = found[robot_id]
        cfg = load_robot_config(robot_id)
        
        try:
            robot = Robot(cfg, robot_id, ip, port, verbose=False)
            if not robot.push_pins():
                print(f"❌ Робот {robot_id} не принял пины!")
                continue
            robots[tag_id] = robot
            print(f"✅ Подключен: {robot_id}")
        except Exception as e:
            print(f"❌ Ошибка подключения к {robot_id}: {e}")
    
    return robots


# ================= ЗАДАЧА 7: Логирование =================

def init_logger():
    """Инициализирует CSV-логгер."""
    csv_filename = f"formation_log_{int(time.time())}.csv"
    csv_file = open(csv_filename, "w", newline="", encoding="utf-8")
    writer = csv.writer(csv_file, delimiter=";")
    writer.writerow(["time", "state", "tag_id", "curr_x", "curr_y", "curr_yaw", 
                     "target_x", "target_y", "cmd_vx", "cmd_vy", "cmd_w"])
    return csv_file, writer


def log_pose(writer, state, tag_id, curr_x, curr_y, curr_yaw, target_x, target_y, cmd_vx, cmd_vy, cmd_w):
    """Записывает одну строку в лог."""
    writer.writerow([time.time(), state, tag_id, curr_x, curr_y, curr_yaw,
                     target_x, target_y, cmd_vx, cmd_vy, cmd_w])


# ================= ЗАДАЧА 10: Конечный автомат =================

def main():
    print("🚀 Запуск системы управления формацией «Треугольник»...")
    
    start_camera()
    time.sleep(1.0)
    
    robots = connect_all_robots()
    if not robots:
        print("❌ Не удалось подключиться ни к одному роботу.")
        stop_camera()
        return
    
    csv_file, writer = init_logger()
    
    # Состояния (Задача 10)
    STATE_BUILDING = "BUILDING"
    STATE_READY = "READY"
    STATE_MOVING = "MOVING"
    state = STATE_BUILDING
    
    stable_since = None
    moving_since = None
    max_move_time = 20.0  # секунд движения вперёд
    
    # Целевые позиции (Задача 8)
    targets = None
    assignments = None
    
    try:
        while True:
            poses = get_all_poses()
            frame = get_frame()
            
            visible_tags = [tid for tid in TAG_IDS if tid in poses]
            if len(visible_tags) < 3:
                print(f"⚠️  Видно только {len(visible_tags)} робота(ов)")
                for r in robots.values():
                    r.drive(0, 0, 0)
                state = STATE_BUILDING
                stable_since = None
                time.sleep(0.1)
                continue
            
            # Проверка связи
            for tag_id, robot in robots.items():
                if robot.seconds_since_reply() > CONNECTION_TIMEOUT:
                    print(f"⚠️  Потеря связи с роботом {tag_id}!")
                    for r in robots.values():
                        r.stop()
                    return
            
            # Расчёт целевых точек (Задача 8)
            if targets is None or state == STATE_BUILDING:
                raw_targets = calculate_equilateral_triangle(poses)
                assignments = assign_robots_to_targets(poses, raw_targets)
                targets = {tag_id: assignments[tag_id] for tag_id in visible_tags}
            
            # Визуализация
            if frame is not None:
                for tag_id in visible_tags:
                    curr_x, curr_y = poses[tag_id][1], poses[tag_id][2]
                    cv2.circle(frame, (int(curr_x), int(curr_y)), 10, (0, 255, 0), -1)
                    
                    if tag_id in targets:
                        target_x, target_y = targets[tag_id]["x"], targets[tag_id]["y"]
                        cv2.line(frame, (int(curr_x), int(curr_y)), 
                                 (int(target_x), int(target_y)), (255, 255, 0), 2)
                        cv2.drawMarker(frame, (int(target_x), int(target_y)), 
                                       (0, 0, 255), cv2.MARKER_CROSS, 15, 2)
                
                cv2.putText(frame, f"State: {state}", (10, 30),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
                cv2.imshow("Formation Triangle", frame)
                key = cv2.waitKey(1) & 0xFF
            else:
                key = -1
            
            # ================= ЗАДАЧА 10: Логика состояний =================
            
            if state == STATE_BUILDING:
                # Строим треугольник
                for tag_id in visible_tags:
                    if tag_id not in robots or tag_id not in targets:
                        continue
                    
                    curr_x, curr_y, curr_yaw = poses[tag_id][1], poses[tag_id][2], poses[tag_id][3]
                    target_x, target_y = targets[tag_id]["x"], targets[tag_id]["y"]
                    
                    cmd_vx, cmd_vy, cmd_w = compute_control_cmd(
                        curr_x, curr_y, curr_yaw, target_x, target_y, moving=False
                    )
                    robots[tag_id].drive(cmd_vx, cmd_vy, cmd_w)
                    
                    log_pose(writer, state, tag_id, curr_x, curr_y, curr_yaw,
                             target_x, target_y, cmd_vx, cmd_vy, cmd_w)
                
                # Проверяем, построен ли треугольник
                all_arrived = True
                for tag_id in visible_tags:
                    if tag_id not in targets:
                        continue
                    curr_x, curr_y = poses[tag_id][1], poses[tag_id][2]
                    target_x, target_y = targets[tag_id]["x"], targets[tag_id]["y"]
                    dist = math.hypot(target_x - curr_x, target_y - curr_y)
                    if dist > BUILD_TOLERANCE:
                        all_arrived = False
                        break
                
                if all_arrived:
                    if stable_since is None:
                        stable_since = time.time()
                        print("✅ Треугольник построен! Ждём стабильности...")
                    elif time.time() - stable_since > BUILD_STABLE_TIME:
                        print("🟢 Треугольник стабилен. Переход в READY.")
                        state = STATE_READY
                        stable_since = None
                        for r in robots.values():
                            r.drive(0, 0, 0)
                else:
                    stable_since = None
            
            elif state == STATE_READY:
                # Ждём подтверждения
                for r in robots.values():
                    r.drive(0, 0, 0)
                
                if frame is not None:
                    cv2.putText(frame, "Press SPACE to start", (100, 100),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
                
                if key == ord(' '):
                    print("🚀 Старт движения вперёд!")
                    state = STATE_MOVING
                    moving_since = time.time()
            
            elif state == STATE_MOVING:
                # Едем вперёд, удерживая формацию
                for tag_id in visible_tags:
                    if tag_id not in robots or tag_id not in targets:
                        continue
                    
                    curr_x, curr_y, curr_yaw = poses[tag_id][1], poses[tag_id][2], poses[tag_id][3]
                    target_x, target_y = targets[tag_id]["x"], targets[tag_id]["y"]
                    
                    # Сдвигаем целевую точку вперёд
                    target_x += TARGET_SPEED_VX * math.cos(curr_yaw) * 0.05
                    target_y += TARGET_SPEED_VX * math.sin(curr_yaw) * 0.05
                    targets[tag_id]["x"] = target_x
                    targets[tag_id]["y"] = target_y
                    
                    cmd_vx, cmd_vy, cmd_w = compute_control_cmd(
                        curr_x, curr_y, curr_yaw, target_x, target_y, moving=True
                    )
                    robots[tag_id].drive(cmd_vx, cmd_vy, cmd_w)
                    
                    log_pose(writer, state, tag_id, curr_x, curr_y, curr_yaw,
                             target_x, target_y, cmd_vx, cmd_vy, cmd_w)
                
                # Авто-остановка через 20 секунд
                if moving_since and (time.time() - moving_since > max_move_time):
                    print(f"⏹  Движение завершено ({max_move_time}с).")
                    state = STATE_READY
                    moving_since = None
                    targets = None
                    for r in robots.values():
                        r.drive(0, 0, 0)
            
            # ================= ЗАДАЧА 11: Аварийная остановка =================
            if key == ord('s'):
                print("⏹  АВАРИЙНАЯ ОСТАНОВКА!")
                state = STATE_READY
                moving_since = None
                targets = None
                for r in robots.values():
                    r.stop()
            
            if key == ord('b'):
                print("🔄 Сброс в BUILDING")
                state = STATE_BUILDING
                stable_since = None
                moving_since = None
                targets = None
            
            if key == ord('q') or key == 27:
                print("🛑 Выход")
                break
            
            csv_file.flush()
            time.sleep(0.05)
    
    except KeyboardInterrupt:
        print("\n🛑 Остановка по Ctrl+C")
    except Exception as e:
        print(f"\n❌ Критическая ошибка: {e}")
        import traceback
        traceback.print_exc()
    finally:
        print("Остановка роботов...")
        for r in robots.values():
            try:
                r.stop()
            except:
                pass
        stop_camera()
        csv_file.close()
        cv2.destroyAllWindows()
        print("✅ Готово")


if __name__ == "__main__":
    main()
